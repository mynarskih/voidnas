NODE_ENV=production
APP_VERSION=0.1.0
DOMAIN=nas.example.com
POSTGRES_DB=voidnas
POSTGRES_USER=voidnas
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://voidnas:replace-with-a-long-random-password@postgres:5432/voidnas?schema=public
SESSION_PEPPER=replace-with-at-least-32-random-bytes
CSRF_SECRET=replace-with-at-least-32-random-bytes
STORAGE_ROOT=/srv/nas/storage
UPLOAD_TTL_HOURS=24
METRICS_URL=http://system-metrics:9100/metrics
TRUST_PROXY=true
COOKIE_SECURE=true

STORAGE_HOST_PATH=./storage
TRASH_RETENTION_DAYS=30
