:80 {
  # Loopback-only fallback while the router's public forwarding is repaired.
  # Secure cookies remain mandatory on the API. Use HTTPS for remote clients.
  @api path /api/*
  reverse_proxy @api api:3000
  reverse_proxy web:80
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Content-Security-Policy "default-src 'none'; script-src 'self'; worker-src 'self'; media-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self'; img-src 'self' data:; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
    -Server
  }
}
